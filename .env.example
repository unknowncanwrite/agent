# ── NEXUS configuration ───────────────────────────────────────────────────────
# Copy this file to .env and fill in what you need. Everything is optional:
# with no key at all NEXUS still runs against local model servers it detects.

# ── Models (at least one, or a local server) ─────────────────────────────────
XKIRO_API_KEY=sk-xt-your-key-here
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# …every cloud preset also accepts <NAME>_BASE_URL to point at a compatible gateway
# NEXUS_NO_LOCAL_DETECT=1   # skip scanning 8081/11434/1234/8080/1337/8000 for local servers

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0              # 127.0.0.1 keeps it off your LAN
NEXUS_TIMEOUT_MS=120000

# ── Access ───────────────────────────────────────────────────────────────────
# false = the agent's file tools are jailed to the workspace.
# true  = full-PC mode: it can read/write anywhere you can and drive the desktop.
AGENT_FULL_ACCESS=false
# AGENT_WORKSPACE=/path/to/workspace

# ── Auto-publish: websites the agent builds go live on the first configured host ──
# Vercel (simplest — deploys straight from the API, no CLI):
# VERCEL_TOKEN=
# VERCEL_SLUG=my-site            # optional: forces the …vercel.app name
# VERCEL_TEAM_ID=               # optional: only for team accounts
# Render (create a Deploy Hook on the service that serves your site):
# RENDER_DEPLOY_HOOK_URL=
# RENDER_API_KEY=               # or the API pair, instead of the hook
# RENDER_SERVICE_ID=
# RENDER_SITE_URL=              # optional: the URL shown back to you
# GitHub Pages (needs an authenticated `gh` CLI):
# PUBLISH_GITHUB_REPO=owner/repo
# PUBLISH_GITHUB_BRANCH=gh-pages
# NEXUS_AUTO_PUBLISH=true       # false = only publish when explicitly asked
# NEXUS_PUBLISH_TIMEOUT_MS=150000
# NEXUS_FORCE_BUILD=false       # true = always rebuild before deploying
