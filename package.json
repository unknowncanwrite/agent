  "description": "NEXUS — autonomous multi-model AI agent with vision, internet and full terminal access",
  "dependencies": {
    "@playwright/browser-chromium": "^1.63.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "openai": "^6.49.0",
    "playwright-core": "^1.63.0"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  }
}
