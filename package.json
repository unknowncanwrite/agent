{
  "name": "nexus-agent",
  "version": "37.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node server.js",
    "setup": "node -e \"import('./setup.js').then(m=>m.ensureBrowser(t=>process.stdout.write(t)))\"",
    "check": "node -e \"import('./selfedit.js').then(async m=>{const r=await m.selfTest();console.log(r.report);process.exit(r.ok?0:1)})\"",
    "build": "node build.js"
  },
